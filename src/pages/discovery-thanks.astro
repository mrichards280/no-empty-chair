---
import Base from "../layouts/Base.astro";
import { LOGO_VIEWBOX, LOGO_INNER_TRANSFORM, CHAIR_PATH, ORB_PATH } from "../lib/logoPaths.js";
---
<Base
  title="Got it | No Empty Chair"
  description="Thanks for filling out your website discovery form."
  canonical="https://noemptychair.co/discovery-thanks"
  noindex={true}>
  <main id="main" class="disc-page">
    <header class="tp-head">
      <a href="/" class="tp-logo">No Empty <span>Chair</span></a>
    </header>
    <div class="tp-wrap">
      <div class="tp-done">
        <div class="tp-mark">
          <svg width="44" height="55.6" viewBox={LOGO_VIEWBOX} preserveAspectRatio="xMidYMid meet" role="img" aria-label="No Empty Chair mark">
            <g fill="#413645" stroke="none"><g transform={LOGO_INNER_TRANSFORM}><path d={CHAIR_PATH} /></g></g>
            <g transform={LOGO_INNER_TRANSFORM}><path d={ORB_PATH} fill="#a85a76" /></g>
          </svg>
        </div>
        <h1>Got it — thank you.</h1>
        <p>Your answers just landed with Makayla. She'll reach out to talk through what fits — no obligation, no pressure.</p>

        <div class="dt-next">
          <div class="dt-next-k">Want a head start?</div>
          <h2>Start with the $200 Teardown</h2>
          <p>A private video breakdown of the highest-impact fixes for your brand, site, and content — the fastest way to see exactly what to do first. It <b>credits toward</b> any package if you go further.</p>
          <a href="/teardown" class="btn">Book the $200 teardown →</a>
        </div>

        <a href="/" class="tp-back-link">← Back to the site</a>
      </div>
    </div>
  </main>
  <style>
    .dt-next{margin:30px auto 8px;max-width:520px;text-align:center;background:var(--white,#fff);border:1px solid var(--line,#e7ddd0);border-radius:16px;padding:28px 26px;box-shadow:0 18px 40px -28px rgba(65,54,69,.4);}
    .dt-next-k{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--rose,#a85a76);font-weight:600;margin-bottom:8px;}
    .dt-next h2{font-family:"Marcellus",serif;font-size:26px;margin-bottom:10px;color:var(--ink,#2a232e);}
    .dt-next p{font-size:14.5px;color:var(--muted,#6b5f57);margin-bottom:18px;line-height:1.55;}
    .dt-next .btn{display:inline-block;}
    .tp-back-link{display:inline-block;margin-top:20px;font-size:13px;color:var(--muted,#6b5f57);letter-spacing:.03em;}
    .tp-back-link:hover{color:var(--ink,#2a232e);}
  </style>
</Base>
