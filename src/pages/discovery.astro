---
import Base from "../layouts/Base.astro";
import { LOGO_VIEWBOX, LOGO_INNER_TRANSFORM, CHAIR_PATH, ORB_PATH } from "../lib/logoPaths.js";
import content from "../../public/content.json";
const packages = content.packages?.items || [];
---
<Base
  title="Discovery | No Empty Chair"
  description="Tell No Empty Chair about you and your business before we talk, a few quick questions ahead of a potential booking."
  canonical="https://noemptychair.co/discovery"
  noindex={true}>
  <main id="main" class="disc-page">
    <header class="tp-head">
      <a href="/" class="tp-logo">No Empty <span>Chair</span></a>
    </header>

    <div class="tp-wrap disc-wrap">
      <div class="tp-mark">
        <svg width="40" height="50.5" viewBox={LOGO_VIEWBOX} preserveAspectRatio="xMidYMid meet" role="img" aria-label="No Empty Chair mark">
          <g fill="#413645" stroke="none"><g transform={LOGO_INNER_TRANSFORM}><path d={CHAIR_PATH} /></g></g>
          <g transform={LOGO_INNER_TRANSFORM}><path d={ORB_PATH} fill="#a85a76" /></g>
        </svg>
      </div>

      <div class="tp-intro">
        <div class="disc-kick">No Empty Chair <span class="disc-free">Free · 15 minutes</span></div>
        <h1>Let's grab 15 minutes</h1>
        <p>This isn't the deep dive, that's the <a href="/teardown" style="color:var(--rose);font-weight:600;border-bottom:1px solid rgba(168,90,118,.4)">$200 Teardown</a>. And it's not just a message that sits in an inbox either. It's a real phone call. Tell me what you want to ask me and I'll text you to pick a time this week.</p>
      </div>

      <div class="disc-offers">
        <div class="disc-offers-k">What's possible</div>
        <div class="disc-offers-row">
          <div class="disc-offer disc-offer-td">
            <div class="disc-offer-name">$200 Teardown</div>
            <div class="disc-offer-price">starts every project</div>
            <div class="disc-offer-desc">A video breakdown of your highest-impact fixes.</div>
          </div>
          {packages.map((pkg) => (
            <div class="disc-offer">
              <div class="disc-offer-name">{pkg.name}</div>
              <div class="disc-offer-price">{pkg.from}</div>
              <div class="disc-offer-desc">{pkg.bullets?.[0]}</div>
            </div>
          ))}
        </div>
      </div>

      <form
        class="tform disc-form"
        name="discovery"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action="/discovery-thanks"
      >
        <input type="hidden" name="form-name" value="discovery" />
        <input class="tp-hp" aria-hidden="true" type="text" name="bot-field" tabindex="-1" autocomplete="off" />

        <div class="tp-row">
          <label>Your name<input type="text" name="name" placeholder="First & last" /></label>
          <label>Business / brand name<input type="text" name="business_name" placeholder="What do you go by?" /></label>
        </div>
        <label>What do you want to ask me on our call?<textarea name="questions" rows="4" placeholder="What's on your mind, what you're weighing, anything you want to walk in already knowing about"></textarea></label>
        <div class="tp-row">
          <label>Best email<input required type="email" name="email" placeholder="you@email.com" /></label>
          <label>Best cell (for the call)<input type="tel" name="phone" placeholder="(404) 555-0123" /></label>
        </div>

        <button class="btn" type="submit">Book my 15 minutes →</button>
        <p class="tp-fine">Goes straight to me. I'll text or call within a day to lock in a time.</p>
      </form>

      <p class="disc-cross">Already know you want the real deep-dive? Skip ahead to the <a href="/teardown">$200 Teardown →</a></p>
    </div>
  </main>
  <style>
    .disc-free{display:inline-block;margin-left:8px;padding:3px 10px;border-radius:100px;background:rgba(168,90,118,.12);color:#a85a76;font-size:11px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;vertical-align:middle;}
    .disc-cross{max-width:620px;margin:22px auto 0;text-align:center;font-size:13.5px;color:#6b5f57;}
    .disc-cross a{color:#a85a76;font-weight:600;border-bottom:1px solid rgba(168,90,118,.4);}
    .disc-cross a:hover{color:#2a232e;}
    .disc-offers{margin:28px auto 34px;max-width:720px;}
    .disc-offers-k{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:#9c4e69;font-weight:600;text-align:center;margin-bottom:12px;}
    .disc-offers-row{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;}
    .disc-offer{background:var(--white,#fff);border:1px solid var(--line,#e7ddd0);border-radius:14px;padding:16px 14px;text-align:left;}
    .disc-offer-td{background:rgba(168,90,118,.06);border-color:rgba(168,90,118,.3);}
    .disc-offer-name{font-family:"Marcellus",serif;font-size:15px;color:#2a232e;margin-bottom:3px;}
    .disc-offer-price{font-size:11.5px;color:#a85a76;font-weight:600;margin-bottom:8px;}
    .disc-offer-desc{font-size:12.5px;color:#6b5f57;line-height:1.4;}
    @media (max-width:760px){.disc-offers-row{grid-template-columns:repeat(2,1fr);}}
    @media (max-width:480px){.disc-offers-row{grid-template-columns:1fr;}}
  </style>
  <script is:inline>
    /* Backup notifier: on submit, also POST to a function that emails you directly,
       so a spam-flagged Netlify submission never means a silently missed lead.
       Fire-and-forget — the native Netlify submission still proceeds normally. */
    (function () {
      var f = document.querySelector('form[name="discovery"]:not([hidden])');
      if (!f) return;
      f.addEventListener("submit", function () {
        try {
          var data = { _form: "discovery" };
          new FormData(f).forEach(function (v, k) {
            if (k === "bot-field" || k === "form-name") return;
            if (data[k] !== undefined) data[k] = [].concat(data[k], v);
            else data[k] = v;
          });
          fetch("/.netlify/functions/lead-notify", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(data),
            keepalive: true,
          }).catch(function () {});
        } catch (e) {}
        /* no preventDefault — let Netlify capture it too */
      });
    })();
  </script>
</Base>
