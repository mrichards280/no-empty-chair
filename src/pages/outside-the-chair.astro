---
import Base from "../layouts/Base.astro";
import { LOGO_VIEWBOX, LOGO_INNER_TRANSFORM, CHAIR_PATH, ORB_PATH } from "../lib/logoPaths.js";
---
<Base
  title="Outside the Chair | No Empty Chair"
  description="Work outside the beauty and wellness space."
  canonical="https://noemptychair.co/outside-the-chair"
  noindex={true}>
  <main id="main" class="disc-page">
    <header class="tp-head">
      <a href="/" class="tp-logo">No Empty <span>Chair</span></a>
    </header>
    <div class="tp-wrap">
      <div class="tp-done otc-wrap">
        <div class="tp-mark">
          <svg width="44" height="55.6" viewBox={LOGO_VIEWBOX} preserveAspectRatio="xMidYMid meet" role="img" aria-label="No Empty Chair mark">
            <g fill="#413645" stroke="none"><g transform={LOGO_INNER_TRANSFORM}><path d={CHAIR_PATH} /></g></g>
            <g transform={LOGO_INNER_TRANSFORM}><path d={ORB_PATH} fill="#a85a76" /></g>
          </svg>
        </div>
        <h1>Outside the chair</h1>
        <p>Most of what I build lives in the beauty and wellness world. Every so often something outside that world needs the same care. Here's one of those.</p>

        <div class="otc-card">
          <div class="otc-k">Brand &amp; Launch Strategy</div>
          <h2>Voice Unlocked</h2>
          <p>A domestic violence awareness podcast and advocacy brand. Worked through logo direction, brand voice, audience, and a launch plan for the show's first season.</p>
          <a href="https://instagram.com/__voiceunlocked" class="otc-link" target="_blank" rel="noopener">See the account on Instagram →</a>
        </div>

        <a href="/" class="tp-back-link">← Back to the site</a>
      </div>
    </div>
  </main>
  <style>
    .otc-wrap{max-width:560px;}
    .otc-card{margin:30px auto 8px;max-width:480px;text-align:left;background:var(--white,#fff);border:1px solid var(--line,#e7ddd0);border-radius:16px;padding:28px 26px;box-shadow:0 18px 40px -28px rgba(65,54,69,.4);}
    .otc-k{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--rose,#a85a76);font-weight:600;margin-bottom:8px;}
    .otc-card h2{font-family:"Marcellus",serif;font-size:24px;margin-bottom:10px;color:var(--ink,#2a232e);}
    .otc-card p{font-size:14.5px;color:var(--muted,#6b5f57);margin-bottom:16px;line-height:1.55;}
    .otc-link{font-size:13.5px;font-weight:600;color:var(--rose,#a85a76);border-bottom:1px solid rgba(168,90,118,.4);}
    .otc-link:hover{color:var(--ink,#2a232e);}
    .tp-back-link{display:inline-block;margin-top:20px;font-size:13px;color:var(--muted,#6b5f57);letter-spacing:.03em;}
    .tp-back-link:hover{color:var(--ink,#2a232e);}
  </style>
</Base>
