---
import Base from "../../layouts/Base.astro";
import { LOGO_VIEWBOX, LOGO_INNER_TRANSFORM, CHAIR_PATH, ORB_PATH } from "../../lib/logoPaths.js";
---
<Base
  title="Discovery | No Empty Chair"
  description="Tell No Empty Chair about you and your project before we talk, a few quick questions ahead of a potential booking."
  canonical="https://noemptychair.co/discovery/general"
  noindex={true}>
  <main id="main" class="disc-page">
    <header class="tp-head">
      <a href="/" class="tp-logo">No Empty <span>Chair</span></a>
    </header>

    <div class="tp-wrap disc-wrap">
      <div class="tp-mark">
        <svg width="40" height="50.5" viewBox={LOGO_VIEWBOX} preserveAspectRatio="xMidYMid meet" role="img" aria-label="No Empty Chair mark">
          <g fill="#413645" stroke="none"><g transform={LOGO_INNER_TRANSFORM}><path d={CHAIR_PATH} /></g></g>
          <g transform={LOGO_INNER_TRANSFORM}><path d={ORB_PATH} fill="#a85a76" /></g>
        </svg>
      </div>

      <div class="tp-intro">
        <div class="disc-kick">No Empty Chair <span class="disc-free">Free · 15 minutes</span></div>
        <h1>Let's talk shop</h1>
        <p>Just enough for me to know who you are and what you're building before we hop on a quick call. No homework, no deep dive, just a conversation. Fill this in and I'll reach out to grab 15 minutes.</p>
      </div>

      <form
        class="tform disc-form"
        name="discovery-general"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action="/discovery-general-thanks"
      >
        <input type="hidden" name="form-name" value="discovery-general" />
        <input class="tp-hp" aria-hidden="true" type="text" name="bot-field" tabindex="-1" autocomplete="off" />

        <label>Who's filling this out?
          <select name="filled_by">
            <option value="client">I'm filling this out myself</option>
            <option value="makayla">Makayla's filling this out with me (call or in person)</option>
          </select>
        </label>

        <div class="disc-sec">
          <div class="disc-sec-h"><span class="disc-num">1</span>The Basics</div>
          <div class="tp-row">
            <label>Your name<input type="text" name="name" placeholder="First & last" /></label>
            <label>Business / brand name<input type="text" name="business_name" placeholder="What do you go by?" /></label>
          </div>
          <div class="tp-row">
            <label>What kind of work do you do?
              <select name="trade">
                <option value="">Choose one…</option>
                <option>Hair / stylist</option>
                <option>Braider / loctician</option>
                <option>Barber</option>
                <option>Nails</option>
                <option>Lashes &amp; brows</option>
                <option>Esthetician / skin</option>
                <option>Spa / massage</option>
                <option>Makeup</option>
                <option>Beauty / wellness brand</option>
                <option>Podcast / media</option>
                <option>Nonprofit / advocacy</option>
                <option>Coach / consultant</option>
                <option>Product brand</option>
                <option>Other</option>
              </select>
            </label>
            <label>What city are you in?<input type="text" name="city" placeholder="Atlanta, GA" /></label>
          </div>
        </div>

        <div class="disc-sec">
          <div class="disc-sec-h"><span class="disc-num">2</span>Where To Find You</div>
          <label>Instagram handle, if you have one<input type="text" name="instagram" placeholder="@yourhandle, so I can peek at your work" /></label>
          <label style="margin-top:14px">Anything you want me to know before we talk?<textarea name="anything_else" rows="3" placeholder="Optional, what made you reach out, what's on your mind, anything at all"></textarea></label>
        </div>

        <div class="disc-sec">
          <div class="disc-sec-h"><span class="disc-num">3</span>How To Reach You</div>
          <div class="tp-row">
            <label>Best email<input required type="email" name="email" placeholder="you@email.com" /></label>
            <label>Best cell (for a quick call)<input type="tel" name="phone" placeholder="(404) 555-0123" /></label>
          </div>
        </div>

        <button class="btn" type="submit">Send my answers →</button>
        <p class="tp-fine">Goes straight to me, I'll reach out to grab 15 minutes on the phone.</p>
      </form>
    </div>
  </main>
  <style>
    .disc-free{display:inline-block;margin-left:8px;padding:3px 10px;border-radius:100px;background:rgba(168,90,118,.12);color:#a85a76;font-size:11px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;vertical-align:middle;}
  </style>
  <script is:inline>
    /* Pre-fill from the link's query string (?name=...&business=...&email=...)
       so a client's basics don't have to be retyped at a later handoff step. */
    (function () {
      try {
        var params = new URLSearchParams(location.search);
        var map = { name: ["name"], business_name: ["business_name", "business"], email: ["email"] };
        var form = document.querySelector('form[name="discovery-general"]:not([hidden])');
        if (!form) return;
        Object.keys(map).forEach(function (field) {
          var input = form.querySelector('[name="' + field + '"]');
          if (!input || input.value) return;
          for (var i = 0; i < map[field].length; i++) {
            var v = params.get(map[field][i]);
            if (v) { input.value = v; break; }
          }
        });
      } catch (e) {}
    })();
  </script>
  <script is:inline>
    /* Backup notifier: on submit, also POST to a function that emails you directly,
       so a spam-flagged Netlify submission never means a silently missed lead.
       Fire-and-forget — the native Netlify submission still proceeds normally. */
    (function () {
      var f = document.querySelector('form[name="discovery-general"]:not([hidden])');
      if (!f) return;
      f.addEventListener("submit", function () {
        try {
          var data = { _form: "discovery-general" };
          new FormData(f).forEach(function (v, k) {
            if (k === "bot-field" || k === "form-name") return;
            if (data[k] !== undefined) data[k] = [].concat(data[k], v);
            else data[k] = v;
          });
          fetch("/.netlify/functions/lead-notify", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(data),
            keepalive: true,
          }).catch(function () {});
        } catch (e) {}
        /* no preventDefault — let Netlify capture it too */
      });
    })();
  </script>
</Base>
